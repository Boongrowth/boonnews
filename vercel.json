{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/article/(.*)",
      "destination": "/api/reader"
    },
    {
      "source": "/reader",
      "destination": "/api/reader"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/category/(.*)",
      "destination": "/category.html"
    },
    {
      "source": "/search",
      "destination": "/searched.html"
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
